{
  "name": "doon-voice-desktop",
  "private": true,
  "version": "0.5.40",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:compile && node --test --experimental-test-coverage .test-dist/test/*.test.mjs && node test/ui-rules.test.mjs && node scripts/test-launcher.mjs && node --test test/distribution.test.mjs",
    "test:ui": "node scripts/ui-regression.mjs",
    "test:compile": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "tauri": "tauri",
    "app": "tauri dev",
    "dist": "tauri build",
    "package:zip": "node scripts/package-installer-zip.mjs",
    "stage:updater": "node scripts/stage-updater-assets.mjs",
    "publish:drive": "node scripts/publish-drive-release.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --check-only"
  },
  "dependencies": {
    "@fontsource/rocknroll-one": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright": "1.62.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
