{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "allow-provider-status",
    "allow-start-official-login",
    "allow-local-llm-status",
    "allow-open-local-llm-install",
    "allow-pull-local-model",
    "allow-transcription-status",
    "allow-download-transcription-model",
    "allow-transcribe-voice",
    "allow-answer-selection-question",
    "allow-open-frontmost-screen-question",
    "allow-paste-question-answer",
    "allow-capture-selected-text",
    "allow-direct-input-status",
    "allow-request-direct-input-permission",
    "allow-open-direct-input-settings",
    "allow-set-voice-shortcut",
    "allow-set-selection-question-shortcut",
    "allow-clear-voice-shortcut",
    "allow-clear-selection-question-shortcut",
    "allow-configure-background-voice",
    "allow-background-voice-status",
    "allow-check-microphone",
    "allow-ack-voice-result",
    "allow-clear-voice-result",
    "allow-retry-voice-processing",
    "allow-cancel-voice-processing",
    "allow-toggle-background-voice"
  ]
}
