{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DOON Voice",
  "version": "0.5.4",
  "identifier": "com.doon.voice.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "DOON Voice",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/whisper-cli"],
    "resources": {
      "resources/engine": "engine",
      "../docs/OSS-NOTICES.md": "OSS-NOTICES.md"
    },
    "icon": [
      "icons/icon-512.png",
      "icons/favicon.ico"
    ],
    "macOS": { "minimumSystemVersion": "12.0" },
    "shortDescription": "話した内容を仕事の文章に整えるアプリ"
  }
}
